# --- Freshdesk (required) ---
# Your helpdesk subdomain: "acme" or "acme.freshdesk.com".
# For the local mock server use: http://127.0.0.1:8765
FRESHDESK_DOMAIN=acme

# Freshdesk > Profile picture (top right) > Profile settings > "View API key"
FRESHDESK_API_KEY=replace-me


# --- Tuning (optional) ---
# Keep below your plan's per-minute API limit (shared with other integrations).
FRESHDESK_MAX_RPM=40
FRESHDESK_MAX_RETRIES=4
FRESHDESK_TIMEOUT=20


# --- HTTP Mode (required when exposing the server remotely) ---
# Agent Studio must send: Authorization: Bearer <this value>
CONNECTOR_BEARER_TOKEN=generate-a-long-random-string
PORT=8000
LOG_LEVEL=INFO
